rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Fields that only the BACKEND (Admin SDK) may write. A malicious user
    // must not be able to run updateDoc(userRef, { subscriptionPlan: "business" })
    // or edit usage counters from the browser console.
    function protectedSubscriptionFields() {
      return [
        'subscriptionPlan',
        'subscriptionStatus',
        'subscriptionProvider',
        'subscriptionOrderId',
        'subscriptionPaymentId',
        'subscriptionAmount',
        'subscriptionCurrency',
        'subscriptionStart',
        'subscriptionExpiry'
      ];
    }

    // ========================================
    // USER PROFILE DOCUMENT
    // ========================================
    match /users/{uid} {
      allow read: if request.auth.uid == uid;

      allow create: if request.auth.uid == uid
        && !request.resource.data.keys().hasAny(protectedSubscriptionFields());

      allow update: if request.auth.uid == uid
        && !request.resource.data.diff(resource.data)
             .affectedKeys().hasAny(protectedSubscriptionFields());

      allow delete: if false;

      // ======================================
      // BACKEND-ONLY WRITE PATHS (read-only for the client)
      // ======================================

      // Monthly usage counters — backend writes, client reads (display only).
      match /usage/{period} {
        allow read: if request.auth.uid == uid;
        allow write: if false;
      }

      // Usage-event audit trail — backend writes only.
      match /usageEvents/{eventId} {
        allow read: if request.auth.uid == uid;
        allow write: if false;
      }

      // Billing orders & payment ledger — backend writes only.
      match /orders/{orderId} {
        allow read: if request.auth.uid == uid;
        allow write: if false;
      }
      match /payments/{paymentId} {
        allow read: if request.auth.uid == uid;
        allow write: if false;
      }

      // Agent metadata (scheduler state) — backend writes only.
      match /agentMeta/{docId} {
        allow read: if request.auth.uid == uid;
        allow write: if false;
      }

      // ======================================
      // APP-OWNED SUBCOLLECTIONS (user-isolated read/write)
      // ======================================
      match /bills/{billId} {
        allow read, write: if request.auth.uid == uid;
      }
      match /gstForms/{formId} {
        allow read, write: if request.auth.uid == uid;
      }
      match /reports/{reportId} {
        allow read, write: if request.auth.uid == uid;
      }
      match /reminders/{reminderId} {
        allow read, write: if request.auth.uid == uid;
      }
      match /emailReminders/{reminderId} {
        allow read, write: if request.auth.uid == uid;
      }
      match /settings/{docId} {
        allow read, write: if request.auth.uid == uid;
      }
      match /stats/{docId} {
        allow read, write: if request.auth.uid == uid;
      }
      match /documents/{docId} {
        allow read, write: if request.auth.uid == uid;
      }
      match /alerts/{alertId} {
        allow read, write: if request.auth.uid == uid;
      }
      match /activityLogs/{logId} {
        allow read, write: if request.auth.uid == uid;
      }
      match /agentRuns/{runId} {
        allow read, write: if request.auth.uid == uid;
      }
      match /businesses/{businessId} {
        allow read: if request.auth.uid == uid;
        // Business creation is plan-limited server-side (POST /api/businesses);
        // direct client writes are not allowed.
        allow write: if false;
      }

      // Unknown subcollections fail closed (no client access).
      match /{document=**} {
        allow read: if request.auth.uid == uid;
        allow write: if false;
      }
    }

    // ========================================
    // LEGACY ROOT-LEVEL COLLECTIONS (keep working)
    // ========================================
    match /reminders/{reminderId} {
      allow read: if request.auth != null &&
                     request.auth.uid == resource.data.userId;
      allow create: if request.auth != null &&
                       request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null &&
                               request.auth.uid == resource.data.userId;
    }

    match /bills/{billId} {
      allow read, write: if request.auth != null &&
                           request.auth.uid == resource.data.userId;
    }

    match /documents/{docId} {
      allow read, write: if request.auth != null &&
                           request.auth.uid == resource.data.userId;
    }

    match /gstForms/{formId} {
      allow read, write: if request.auth != null &&
                           request.auth.uid == resource.data.userId;
    }

    match /reports/{reportId} {
      allow read, write: if request.auth != null &&
                           request.auth.uid == resource.data.userId;
    }

    // ========================================
    // FIREBASE EMAIL EXTENSION - SMTP
    // ========================================
    match /mail/{mailId} {
      allow create: if request.auth != null;
      allow read, update: if request.auth != null ||
                             (request.auth.uid == null &&
                              request.headers['Authorization'].matches('^Bearer .+$'));
    }

    // ========================================
    // DENY ALL OTHER ACCESS
    // ========================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
