# ============================================================
# AI GST & Compliance Buddy — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ============================================================

# ============================================================
# PUBLIC CLIENT VARIABLES (safe to expose — used in browser)
# Prefix: REACT_APP_
# ============================================================

# Firebase Client Configuration (get from Firebase Console → Project Settings)
REACT_APP_FIREBASE_API_KEY=your_firebase_api_key_here
REACT_APP_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
REACT_APP_FIREBASE_DATABASE_URL=https://your-project.firebaseio.com
REACT_APP_FIREBASE_PROJECT_ID=your-project-id
REACT_APP_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
REACT_APP_FIREBASE_APP_ID=your_app_id
REACT_APP_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# App Settings
REACT_APP_ENVIRONMENT=production
REACT_APP_AUTH_REDIRECT_URL=https://your-domain.vercel.app

# Email sender address (display only)
REACT_APP_EMAIL_FROM=noreply@your-domain.com

# ============================================================
# SERVER SECRET VARIABLES (NEVER prefix with REACT_APP_)
# Set these in Vercel Dashboard → Environment Variables → Server
# ============================================================

# Google Gemini API Key (server-side only — never expose to browser)
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional Gemini settings
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_MAX_OUTPUT_TOKENS=8192  (keep high — the invoice schema is large;
#                                  a low cap truncates JSON and returns 502)
# GEMINI_TIMEOUT_MS=55000

# Firebase Admin SDK (server-side only)
# Get from: Firebase Console → Project Settings → Service Accounts → Generate New Private Key
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Cashfree Payment Gateway (server-side only — NEVER a REACT_APP_ variable)
# Get credentials from: https://merchant.cashfree.com/ → Settings → API Keys
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key
# sandbox | production  (production requires Cashfree merchant/payment product activation)
CASHFREE_ENV=sandbox
# Webhook secret — create in Cashfree Dashboard → Settings → Webhooks.
# Used to verify POST /api/payment/webhook HMAC signatures (base64(hmac_sha256(timestamp+body, secret))).
CASHFREE_WEBHOOK_SECRET=your_cashfree_webhook_secret

# Business-plan fair-use safety ceilings (internal — never advertised to users
# unless the threshold is actually reached). Tune to control external AI/API cost.
# BUSINESS_FAIR_USE_INVOICES=1000
# BUSINESS_FAIR_USE_AI_EXTRACTIONS=1000
# BUSINESS_FAIR_USE_DOCUMENTS=500

# Cron Secret — used to authenticate Vercel Cron job calls
# Generate with: openssl rand -hex 32
CRON_SECRET=your_cron_secret_here

# Email (Brevo SMTP)
BREVO_API_KEY=your_brevo_smtp_key_here
EMAIL_FROM=noreply@your-domain.com

# ============================================================
# DEVELOPMENT ONLY — do NOT set these in production
# ============================================================

# Set to false in production — eliminates in-memory mock database
# USE_MOCK_DATABASE=false
