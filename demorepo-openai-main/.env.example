# ============================================================
# AI GST & Compliance Buddy — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ============================================================

# ============================================================
# PUBLIC CLIENT VARIABLES (safe to expose — used in browser)
# Prefix: REACT_APP_
# ============================================================

# Firebase Client Configuration (get from Firebase Console → Project Settings)
REACT_APP_FIREBASE_API_KEY=your_firebase_api_key_here
REACT_APP_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
REACT_APP_FIREBASE_DATABASE_URL=https://your-project.firebaseio.com
REACT_APP_FIREBASE_PROJECT_ID=your-project-id
REACT_APP_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
REACT_APP_FIREBASE_APP_ID=your_app_id
REACT_APP_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# App Settings
REACT_APP_ENVIRONMENT=production
REACT_APP_AUTH_REDIRECT_URL=https://your-domain.vercel.app

# Razorpay PUBLIC key only (key_id is safe for browser)
REACT_APP_RAZORPAY_KEY_ID=rzp_live_XXXXXXXXXXXX

# Email sender address (display only)
REACT_APP_EMAIL_FROM=noreply@your-domain.com

# ============================================================
# SERVER SECRET VARIABLES (NEVER prefix with REACT_APP_)
# Set these in Vercel Dashboard → Environment Variables → Server
# ============================================================

# Google Gemini API Key (server-side only — never expose to browser)
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional Gemini settings
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_MAX_OUTPUT_TOKENS=8192  (keep high — the invoice schema is large;
#                                  a low cap truncates JSON and returns 502)
# GEMINI_TIMEOUT_MS=55000

# Firebase Admin SDK (server-side only)
# Get from: Firebase Console → Project Settings → Service Accounts → Generate New Private Key
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Razorpay SECRET key (server-side only — NEVER a REACT_APP_ variable)
RAZORPAY_KEY_ID=rzp_live_XXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# Cron Secret — used to authenticate Vercel Cron job calls
# Generate with: openssl rand -hex 32
CRON_SECRET=your_cron_secret_here

# Email (Brevo SMTP)
BREVO_API_KEY=your_brevo_smtp_key_here
EMAIL_FROM=noreply@your-domain.com

# ============================================================
# DEVELOPMENT ONLY — do NOT set these in production
# ============================================================

# Set to false in production — eliminates in-memory mock database
# USE_MOCK_DATABASE=false
